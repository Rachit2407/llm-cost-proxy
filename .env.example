# Proxy Server
PROXY_HOST=0.0.0.0
PROXY_PORT=8080
LOG_LEVEL=INFO

# Storage Backends
# Local dev default uses SQLite; Docker Compose overrides with PostgreSQL
DATABASE_URL=sqlite+aiosqlite:///./llm_cost_proxy.db
# Set to redis://localhost:6379/0 when Redis is running, or memory:// for local in-memory mode
REDIS_URL=memory://

# Cache Configuration
CACHE_TTL_SECONDS=86400
SEMANTIC_SIMILARITY_THRESHOLD=0.90
MAX_CACHE_TEMPERATURE=0.3
EMBEDDING_PROVIDER=local_hash
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=256

# Rate Limits & Budgets (Defaults per Tenant)
DEFAULT_RPM_LIMIT=60
DEFAULT_TPM_LIMIT=100000
DEFAULT_MONTHLY_BUDGET_USD=50.0
ALERT_WEBHOOK_URL=
ALERT_THRESHOLD_RATIO=0.80

# Upstream Providers (Supply via environment at runtime; never hardcode keys)
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_API_KEY=

# Auth: JSON mapping of proxy virtual keys to tenant policies (leave empty for open dev key)
# Example: {"pk-startup-dev": {"tenant_id": "acme", "rpm_limit": 120, "tpm_limit": 200000, "monthly_budget_usd": 100.0}}
PROXY_API_KEYS_JSON={}
ALLOW_ANONYMOUS_DEV=true
